<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled Action for Background Batch Processing -->
    <record id="ir_cron_niits_migrate_worker" model="ir.cron">
        <field name="name">Easy Migrate: Background Worker</field>
        <field name="model_id" ref="model_niits_migrate_job"/>
        <field name="state">code</field>
        <field name="code">model.run_cron_worker()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
